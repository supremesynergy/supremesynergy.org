{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/call",
      "destination": "https://calendar.app.google/dXFrBcwRA1i65nGs8",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ13LAOwfl97s2LfXZQkC5J3_Kog0FCbajIIiN7Y6Jwj9L7pgcF5g845GesAFrmgRk-2PR6hTDHs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/map",
      "destination": "https://supreme-map.vercel.app/map"
    },
    {
      "source": "/map/:path*",
      "destination": "https://supreme-map.vercel.app/map/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/reader-e299d46be3",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/downloads/The-Broken-Map-Part-One-e299d46be3.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
